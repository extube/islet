#!/usr/bin/env bash
# Block direct commits on main/dev, and enforce the branch naming policy.
set -uo pipefail

. "$(dirname "$0")/common.sh"

branch="$(current_branch)"
[ -n "$branch" ] || exit 0

if [ "$branch" = "main" ]; then
    deny "commits to 'main' are restricted — create a branch from 'dev' for new features"
fi

if [ "$branch" = "dev" ]; then
    # Merge commits into dev are validated by commit-msg (source naming);
    # direct commits stay blocked.
    [ -f "$(git rev-parse --git-dir)/MERGE_HEAD" ] || {
        deny "commits to 'dev' are restricted — create a branch from 'dev' for new features"
    }
    exit 0
fi

if ! feature_branch_name "$branch"; then
    deny "branch '${branch}' has an invalid name — use feat|bug|hotfix-#<number>-<description>"
fi

exit 0
